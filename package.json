{
  "name": "tikninja-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:app": "npm run build --workspace=apps/app",
    "build:worker": "npm run build --workspace=apps/worker",
    "start:app": "npm run start --workspace=apps/app",
    "start:worker": "npm run start --workspace=apps/worker",
    "dev:app": "npm run dev --workspace=apps/app"
  }
}
